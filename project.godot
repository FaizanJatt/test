; Engine configuration file.
; Freja CloudRig Assessment - third-person demo with runtime outfit customization.
; Input actions are registered at runtime in scripts/game/input_setup.gd (autoload "GameInput").

config_version=5

[application]

config/name="Freja Demo"
config/description="Third-person demo: PUBG-style locomotion + runtime outfit/clothing customization for the Freja CloudRig character."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
run/max_fps=120

[autoload]

GameInput="*res://scripts/game/input_setup.gd"

[debug]

gdscript/warnings/treat_warnings_as_errors=false
gdscript/warnings/untyped_declaration=0
gdscript/warnings/inference_on_variant=0
gdscript/warnings/shadowed_variable_base_class=0

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation="landscape"

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3

[physics]

3d/default_gravity=18.0
