; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Freja Demo"
config/description="Third-person demo: PUBG-style locomotion + runtime outfit/clothing customization for the Freja CloudRig character."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=120
config/icon="res://icon.svg"

[autoload]

GameInput="*res://scripts/game/input_setup.gd"

[debug]

gdscript/warnings/shadowed_variable_base_class=0
gdscript/warnings/inference_on_variant=0
gdscript/warnings/treat_warnings_as_errors=false

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation="landscape"

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

3d/default_gravity=18.0

[rendering]

textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
anti_aliasing/quality/msaa_3d=2
